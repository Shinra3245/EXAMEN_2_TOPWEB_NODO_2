<%- include('partials/header') %>
<h1>Abrir cuenta</h1>

<% if (error) { %><p class="error"><%= error %></p><% } %>
<% if (cuenta) { %>
  <div class="tarjeta exito">
    <p><strong>Cuenta creada</strong></p>
    <p>Número de cuenta: <strong><%= cuenta.numero_cuenta %></strong></p>
    <p>Titular: <%= cuenta.titular %></p>
    <p>Saldo: $<%= dinero(cuenta.saldo) %></p>
  </div>
<% } %>

<form method="post" action="/cuentas" class="tarjeta">
  <input type="hidden" name="idempotency_key" value="<%= valores.idempotency_key %>">
  <label>Nombre del titular
    <input name="titular" required maxlength="255" value="<%= valores.titular || '' %>">
  </label>
  <label>Saldo inicial
    <input name="saldo_inicial" type="number" min="0" step="0.01" required value="<%= valores.saldo_inicial ?? '1000' %>">
  </label>
  <button type="submit">Crear cuenta</button>
</form>
<%- include('partials/footer') %>
