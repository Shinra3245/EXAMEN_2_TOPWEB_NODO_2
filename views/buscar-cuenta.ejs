<%- include('partials/header') %>
<h1>Consultar cuenta</h1>

<form method="get" action="/cuentas/buscar" class="tarjeta en-linea">
  <input name="numero" placeholder="Número de cuenta" value="<%= numero %>" required>
  <button type="submit">Buscar</button>
</form>

<% if (error) { %><p class="error"><%= error %></p><% } %>
<% if (cuenta) { %>
  <div class="tarjeta">
    <p><strong>Cuenta:</strong> <%= cuenta.numero_cuenta %></p>
    <p><strong>Titular:</strong> <%= cuenta.titular %></p>
    <p><strong>Saldo:</strong> $<%= dinero(cuenta.saldo) %></p>
    <p><strong>Estado:</strong> <span class="estado <%= cuenta.estado %>"><%= cuenta.estado %></span></p>
    <a href="/historial?cuenta=<%= encodeURIComponent(cuenta.numero_cuenta) %>&amp;alcance=cuenta">Ver historial completo de la cuenta</a>
  </div>
<% } %>
<%- include('partials/footer') %>
